  "query": "\n            DELETE FROM auth_tokens\n            WHERE user_id=$1 \n                AND purpose=$2\n                AND token_hash=$3\n                AND expired_at > NOW()\n            RETURNING \n                token_hash, user_id,\n                purpose AS \"purpose: AuthTokenPurpose\",\n                created_at, expired_at\n            ",
