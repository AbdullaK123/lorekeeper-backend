data: {"type":"streamAssistantItem","item":"event","value":{"event":"end","part":1,"content":{"type":"text","text":"That’s a potent secret: Asha carries the key to a room beneath the lighthouse her Guild maintains, and only Iven knows. What’s in the old lens room—or why has it stayed locked?"}}}

