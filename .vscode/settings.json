{
    // Show real compiler errors. Your global settings turn this off.
    "rust-analyzer.checkOnSave": true,
    // Keep compiler diagnostics fast; run clippy separately.
    "rust-analyzer.check.command": "check",
    // Check the API on save. Run the full test-target check separately.
    "rust-analyzer.cargo.allTargets": false,
    "rust-analyzer.check.allTargets": false,

    // Own build folder, so rust-analyzer and `cargo` in the terminal stop waiting on each other.
    "rust-analyzer.cargo.targetDir": true,
    // Use four analysis workers and two Cargo jobs on this 12-thread host.
    "rust-analyzer.numThreads": 4,
    // Keep more syntax trees to reduce repeated parsing during navigation.
    "rust-analyzer.lru.capacity": 64,
    // Avoid eagerly computing the entire dependency graph on startup.
    "rust-analyzer.cachePriming.enable": false,
    "rust-analyzer.cargo.extraArgs": ["--jobs", "2"],
    // Check inherits cargo.extraArgs. Repeating --jobs makes Cargo reject the command.
    "rust-analyzer.check.extraArgs": [],
    // SQLx and Askama need macro expansion and build scripts.
    "rust-analyzer.cargo.buildScripts.enable": true,
    "rust-analyzer.procMacro.enable": true,
    "rust-analyzer.procMacro.processes": 1,
    // Instrumentation wraps async bodies. Skip only that expansion in IDE analysis.
    // Cargo still expands and checks it. SQLx, Askama, serde, and async traits stay enabled.
    "rust-analyzer.procMacro.ignored": {
        "tracing-attributes": ["instrument"]
    },
    // Suppress notices for the macro we intentionally skip; keep unlinked-file checks.
    "rust-analyzer.diagnostics.disabled": ["attribute-expansion-disabled"],
    "rust-analyzer.files.exclude": ["target", ".git", "playground/node_modules", "playground/dist", "tests/artifacts"],
    // Validate new SQL against the local Compose database while developing.
    // Docker and CI can still use SQLX_OFFLINE=true with prepared .sqlx metadata.
    "rust-analyzer.cargo.extraEnv": {
        "SQLX_OFFLINE": "false",
        "DATABASE_URL": "postgresql://dev:password@localhost:5433/app_db",
        "CARGO_INCREMENTAL": "1"
    },
    // Macro workers must use the same database mode as Cargo checks.
    "rust-analyzer.server.extraEnv": {
        // Temporary: capture the next real editor startup; remove after diagnosis.
        "RA_PROFILE": "*@3>100",
        "RA_LOG": "rust_analyzer=info",
        "SQLX_OFFLINE": "false",
        "DATABASE_URL": "postgresql://dev:password@localhost:5433/app_db"
    },

    // Tidy the code on every save.
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true
    },

    // Don't let VS Code watch or search the huge build folder.
    "files.watcherExclude": {
        "**/target/**": true,
        "**/playground/node_modules/**": true,
        "**/tests/artifacts/**": true
    },
    "search.exclude": {
        "**/target": true
    }
}
